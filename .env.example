# Transport for the MCP server: stdio (default) or http
EVALSMITH_TRANSPORT=stdio
EVALSMITH_HTTP_PORT=3333
LOG_LEVEL=info

# Optional LLM judge for detect_prompt_regression. Disabled unless a request opts in.
# Any OpenAI-compatible endpoint works; for Ollama use http://localhost:11434/v1
EVALSMITH_JUDGE_BASE_URL=http://localhost:11434/v1
EVALSMITH_JUDGE_MODEL=llama3.1:8b
EVALSMITH_JUDGE_API_KEY=
